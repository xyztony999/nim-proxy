# ===== NIM Proxy 配置 =====
# 复制为 .env 后填写（deploy.sh 也会帮你生成）

# 上游 NVIDIA NIM 密钥（nvapi-xxx），多个用英文逗号分隔，会自动轮询 + 失败切换
NVIDIA_API_KEYS=nvapi-xxxxxxxxxxxxxxxx,nvapi-yyyyyyyyyyyyyyyy

# 客户端访问本代理用的密钥（自己随便定一个长随机串），多个用逗号分隔
# 留空 = 不鉴权（不推荐，公网上等于裸奔）
PROXY_API_KEYS=sk-my-proxy-key-please-change-me

# 服务监听端口（防火墙/安全组记得放行）
PORT=8000

# 上游地址，一般不用改
# NIM_UPSTREAM=https://integrate.api.nvidia.com

# 超时（秒），流式长回复建议保持较大的 read 超时
# CONNECT_TIMEOUT=15
# READ_TIMEOUT=600
